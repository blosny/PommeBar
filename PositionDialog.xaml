<Window x:Class="PommeBar.PositionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PommeBar Görünüm &amp; Konum" Height="260" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border CornerRadius="16" Background="#F01C1C1E" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="🍎 PommeBar Görünüm &amp; Konum" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Widget'ı nasıl ve nerede kullanmak istersiniz?" FontSize="12" Foreground="#B0FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,12" />

            <!-- Appearance Mode Selection -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BtnModeFloating" Content="🏝️ Ada Modu (Çubuk Üstü)" Margin="3" Padding="8" HorizontalAlignment="Stretch" Cursor="Hand" Click="BtnModeFloating_Click" />
                <ui:Button Grid.Column="1" x:Name="BtnModeEmbedded" Content="📌 Görev Çubuğuna Sıfır" Margin="3" Padding="8" HorizontalAlignment="Stretch" Cursor="Hand" Click="BtnModeEmbedded_Click" />
            </Grid>

            <!-- Position Selection -->
            <UniformGrid Grid.Row="3" Columns="3" Margin="0,2,0,0">
                <ui:Button x:Name="BtnLeft" Content="⬅️ Sol (Başlat)" Margin="3" Padding="8" HorizontalAlignment="Stretch" Cursor="Hand" Click="BtnLeft_Click" />
                <ui:Button x:Name="BtnCenter" Content="⏺️ Orta (İkonlar)" Margin="3" Padding="8" HorizontalAlignment="Stretch" Cursor="Hand" Click="BtnCenter_Click" />
                <ui:Button x:Name="BtnRight" Content="➡️ Sağ (Saat)" Margin="3" Padding="8" HorizontalAlignment="Stretch" Cursor="Hand" Click="BtnRight_Click" />
            </UniformGrid>
        </Grid>
    </Border>
</Window>
